(version 1)
(deny default)
(deny network*)
(allow process-fork)
(allow process-exec (subpath (param "TOOLCHAIN")) (subpath "/bin") (subpath "/usr/bin") (subpath "/Library/Developer/CommandLineTools"))
(allow sysctl-read)
(allow signal (target self))
(allow file-read-metadata)
(allow file-read*
  (literal "/")
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/Library/Apple/System")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath (param "AUDIT_ROOT"))
  (subpath "/bin")
  (subpath "/usr/bin")
  (literal "/private/etc/localtime")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (subpath (param "TOOLCHAIN"))
  (subpath (param "SOURCE"))
  (subpath (param "RUN")))
(allow file-write* (subpath (param "RUN")) (literal "/dev/null"))
