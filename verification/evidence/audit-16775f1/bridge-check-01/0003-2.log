@AuditBridge.family_selected_iff : ∀ {n : Nat} (H : JSP690.Hypergraph n) (F : AuditBridge.EdgeFamily n)
  (hsub : ∀ (S : AuditBridge.VertexSet n), F S → @AuditBridge.family n H S) (S : AuditBridge.VertexSet n),
